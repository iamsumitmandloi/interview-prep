{
  "id": "001-ai",
  "title": "stateful vs stateless (ai voice, panda)",
  "audio": "voice/001.mp3",
  "words": "captions/001-ai.words.json",
  "credit": "Q inspired by debasmitasarkar/flutter_interview_guide_2026",
  "events": [
    {"at": "Interview question", "do": "card", "kind": "Q", "text": "`StatefulWidget` vs `StatelessWidget`?"},
    {"at": "Quick answer", "do": "clear"},
    {"at": "doesn't hold", "do": "pop", "text": "NO STATE", "style": "slam", "color": "pink"},
    {"at": "does hold", "do": "pop", "text": "HOLDS STATE", "style": "stretch", "color": "cyan"},
    {"at": "like button", "do": "zoom", "scale": 1.2, "forMs": 2600},
    {"at": "But here's", "do": "card", "kind": "TWIST", "text": ["if it changes…", "why is `StatefulWidget`", "marked `@immutable`?"]},
    {"at": "Because it", "do": "clear"},
    {"at": "Both of", "do": "pop", "text": "BOTH. 🤯", "style": "slam", "color": "yellow", "sfx": "boom", "forMs": 1500},
    {"at": "blueprint", "do": "code", "snippet": "stateful_immutable", "highlight": [1, 7], "caption": "a widget = a read-only blueprint"},
    {"at": "separate State", "do": "objects", "preset": "widget_vs_state", "step": "show"},
    {"at": "held by the element", "do": "tree", "preset": "three_trees", "step": "build", "full": true},
    {"at": "brand new", "do": "tree", "step": "rebuild", "sfx": "shatter"},
    {"at": "element stays", "do": "tree", "step": "state", "sfx": "ding"},
    {"at": "never changed", "do": "clear"},
    {"at": "got replaced", "do": "pop", "text": "REPLACED.", "style": "shatter", "color": "pink", "forMs": 1400, "sfx": "shatter", "offset": 250},
    {"at": "Remember this", "do": "card", "kind": "RECALL", "text": ["widgets are **replaced**, not changed", "state lives in `State`", "held by the **element**"]},
    {"at": "Which raises", "do": "card", "kind": "NEXT", "text": "if widgets get thrown away on every rebuild… isn't that slow?"}
  ]
}
